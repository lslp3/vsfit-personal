import { useState } from 'react';
import { Search, X } from 'lucide-react';
import { Input, Select } from '../ui/Input';
import { Button } from '../ui/Button';
import { cn } from '../../lib/utils';

interface ExerciseFiltersProps {
  filters: {
    search: string;
    muscleGroup: string;
    equipment: string;
    category: string;
  };
  onChange: (updates: Partial<{
    search: string;
    muscleGroup: string;
    equipment: string;
    category: string;
  }>) => void;
  options: {
    muscleGroups: string[];
    equipment: string[];
    categories: string[];
    loading: boolean;
  };
}

export function ExerciseFilters({ filters, onChange, options }: ExerciseFiltersProps) {
  const hasActiveFilters = !!(filters.search || filters.muscleGroup || filters.equipment || filters.category);

  const clearFilters = () => {
    onChange({
      search: '',
      muscleGroup: '',
      equipment: '',
      category: '',
    });
  };

  return (
    <div className="flex flex-col gap-4 w-full">
      <div className="grid grid-cols-1 md:grid-cols-4 gap-3">
        {/* Search Input */}
        <div className="relative md:col-span-1">
          <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-vs-muted" />
          <Input 
            className="pl-10 rounded-[16px]" 
            placeholder="Buscar exercício..." 
            value={filters.search}
            onChange={(e) => onChange({ search: e.target.value })}
          />
        </div>

        {/* Muscle Group Select */}
        <Select
          placeholder="Grupo Muscular"
          value={filters.muscleGroup}
          options={options.muscleGroups.map(mg => ({ value: mg, label: mg }))}
          onChange={(val) => onChange({ muscleGroup: val })}
          className="rounded-[16px]"
        />

        {/* Equipment Select */}
        <Select
          placeholder="Equipamento"
          value={filters.equipment}
          options={options.equipment.map(eq => ({ value: eq, label: eq }))}
          onChange={(val) => onChange({ equipment: val })}
          className="rounded-[16px]"
        />

        {/* Category Select */}
        <Select
          placeholder="Categoria"
          value={filters.category}
          options={options.categories.map(cat => ({ value: cat, label: cat }))}
          onChange={(val) => onChange({ category: val })}
          className="rounded-[16px]"
        />
      </div>

      {hasActiveFilters && (
        <div className="flex justify-end">
          <Button 
            variant="secondary" 
            onClick={clearFilters}
            className="rounded-[12px] text-xs h-9 px-3"
          >
            <X className="w-3 h-3 mr-1" /> Limpar Filtros
          </Button>
        </div>
      )}
    </div>
  );
}
